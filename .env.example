# Copy this file to `.env` and fill in the values.
# `.env` must not be committed — it is listed in .gitignore.
#
# Full instructions: docs/ANALYTICS_SETUP.md

# Google Analytics 4 measurement ID, from Admin → Data streams → Web.
# Looks like G-XXXXXXXXXX. Leave blank and no analytics code loads at all.
VITE_GA4_ID=

# Google Search Console verification token, if you choose the "HTML tag"
# verification method. Paste ONLY the content value from the meta tag Google
# shows you, not the whole tag.
#
# If you use the "HTML file" method instead, ignore this: drop the
# google<something>.html file Google gives you into public/ and rebuild.
GSC_VERIFICATION=
